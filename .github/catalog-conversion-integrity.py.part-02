  phone: string;
  country: string;
  occasion?: string;
  budget?: string;
}) => {
  if (typeof window.gtag === 'function') {
    window.gtag('event', 'generate_lead', {
      currency: 'USD',
      value: 0, // Lead value can be set based on budget
      lead_category: 'styling_consultation',
      event_category: 'engagement',
      event_label: data.occasion || 'styling_consultation',
      user_data: {
        phone_number: data.phone,
        address: {
          country: data.country,
        },
      },
    });
  }
};""",
    """// Consultation lead tracking. Never send names, email addresses, phone
// numbers, or other user-provided contact data to Google Analytics.
export const trackConsultationSubmission = (data: {
  country: string;
  occasion?: string;
}) => {
  if (typeof window.gtag === 'function') {
    window.gtag('event', 'generate_lead', {
      currency: 'USD',
      value: 0,
      lead_category: 'styling_consultation',
      event_category: 'engagement',
      event_label: data.occasion || 'styling_consultation',
      lead_country: data.country,
    });
  }
};""",
    "analytics PII removal",
)
write("src/hooks/useAnalytics.ts", analytics)

wedding = read("src/pages/WeddingPartyOrders.tsx")
wedding = replace_once(
    wedding,
    "trackConsultationSubmission({ name, email, phone, country, occasion: 'wedding_party_group_order', budget });",
    "trackConsultationSubmission({ country, occasion: 'wedding_party_group_order' });",
    "WeddingPartyOrders analytics call",
)
write("src/pages/WeddingPartyOrders.tsx", wedding)

