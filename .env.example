# Shopify Storefront API
# Get these from Shopify Admin > Apps > Develop apps > [Your App] > API credentials
# IMPORTANT: Never commit the actual token to the repository.
# After deploying, add these as environment variables in Vercel Dashboard > Settings > Environment Variables.
# Also add SHOPIFY_STOREFRONT_TOKEN as a Supabase Edge Function secret
# (Supabase Dashboard > Edge Functions > Secrets).

# Client-side token (VITE_ prefix required for Vite to expose it)
VITE_SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here

# Optional branded hosted-checkout hostname. Leave unset until Shopify is
# configured for the domain and checkout.luxemia.shop DNS is verified.
# Without it, checkout stays on lovable-project-zlh0w.myshopify.com.
# VITE_SHOPIFY_CHECKOUT_HOST=checkout.luxemia.shop

# Server-side token (used by middleware, build scripts, and Supabase edge functions)
SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here
