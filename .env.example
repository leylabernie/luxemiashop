# Shopify Storefront API
# Get these from Shopify Admin > Apps > Develop apps > [Your App] > API credentials
# IMPORTANT: Never commit the actual token to the repository.
# After deploying, add these as environment variables in Vercel Dashboard > Settings > Environment Variables.
# Also add SHOPIFY_STOREFRONT_TOKEN as a Supabase Edge Function secret
# (Supabase Dashboard > Edge Functions > Secrets).

# Client-side token (VITE_ prefix required for Vite to expose it)
VITE_SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here

# Optional checkout host override for legacy/storefront-relative cart URLs.
# Shopify URLs on https://checkout.luxemia.shop are accepted directly with
# their returned path and query parameters preserved.
# VITE_SHOPIFY_CHECKOUT_HOST=checkout.luxemia.shop

# Server-side token (used by middleware, build scripts, and Supabase edge functions)
SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here

# Free retargeting pixels (optional, no cost to create the accounts).
# Create the IDs for free — Meta Events Manager, Pinterest Tag, TikTok
# Events Manager — then set them in Vercel > Settings > Environment
# Variables and redeploy. Leave unset to disable a network entirely;
# with none set, no marketing script is loaded at all.
# VITE_META_PIXEL_ID=
# VITE_PINTEREST_TAG_ID=
# VITE_TIKTOK_PIXEL_ID=

# Marketing scripts also require explicit visitor opt-in through Privacy choices.
# Consent is independent of the production-host/QA switch.

# TEMPORARY GA4 cross-domain test: set this only for the approved Vercel preview
# deployment, to its exact hostname (for example, branch-name.vercel.app).
# Vercel preview builds additionally require ?luxemia_preview_analytics=1.
# Do not use a wildcard or a production domain; remove this setting after testing.
# LUXEMIA_GA4_PREVIEW_HOST=
