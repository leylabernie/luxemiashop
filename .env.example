# Shopify Storefront API
# Get these from Shopify Admin > Apps > Develop apps > [Your App] > API credentials
# IMPORTANT: Never commit the actual token to the repository.
# After deploying, add these as environment variables in Vercel Dashboard > Settings > Environment Variables.
# Also add SHOPIFY_STOREFRONT_TOKEN as a Supabase Edge Function secret
# (Supabase Dashboard > Edge Functions > Secrets).

# Client-side token (VITE_ prefix required for Vite to expose it)
VITE_SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here

# Optional checkout host override for legacy/storefront-relative cart URLs.
# Shopify URLs on https://checkout.luxemia.shop are accepted directly with
# their returned path and query parameters preserved.
# VITE_SHOPIFY_CHECKOUT_HOST=checkout.luxemia.shop

# Server-side token (used by middleware, build scripts, and Supabase edge functions)
SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here

# ─── Lead sync: Supabase Database Webhook → Shopify customer (api/sync-lead.ts) ──
# Create a Supabase Database Webhook on INSERT for the lead-capture table and
# point it at https://luxemia.shop/api/sync-lead, then copy the same secret into
# both places. The function fails closed (503) while this is unset, and rejects
# any request whose x-supabase-webhook-secret header does not match exactly.
SUPABASE_WEBHOOK_SECRET=

# Shopify Admin API token (custom app) needing read_customers + write_customers
# and access to protected customer data. SHOPIFY_ADMIN_ACCESS_TOKEN — the name
# scripts/bulk-write-shopify-seo.mjs already uses — is accepted as a fallback.
# Never commit the real token; set it in Vercel > Settings > Environment Variables.
SHOPIFY_ADMIN_API_TOKEN=

# Optional. The Supabase project has no `email_captures` table yet: the live lead
# sources are `newsletter_subscribers` (FIRST10 consent) and `abandoned_carts`
# (transactional cart reminders). Defaults to email_captures; set the real table
# name(s), comma-separated, to match the webhook you create.
# SUPABASE_WEBHOOK_TABLES=newsletter_subscribers

# Optional. Shopify serves each Admin API version for about 12 months, so pin one
# that is still served (2026-01 … 2026-10 today) and bump it each quarter.
# Defaults to 2026-01, the version Shopify falls a removed one forward to.
# SHOPIFY_ADMIN_API_VERSION=2026-01
# SHOPIFY_ADMIN_STORE_DOMAIN=lovable-project-zlh0w.myshopify.com

# Optional. Marketing consent for leads with no explicit signal in the record.
# A record that identifies itself as a cart capture is always treated as
# transactional, because /privacy publishes that marketing emails go out "only
# with your consent". Set to false to require an explicit opt-in on every record.
# SYNC_LEAD_DEFAULT_MARKETING_CONSENT=true
# SYNC_LEAD_MARKETING_OPT_IN_LEVEL=single_opt_in

# Free retargeting pixels (optional, no cost to create the accounts).
# Create the IDs for free — Meta Events Manager, Pinterest Tag, TikTok
# Events Manager — then set them in Vercel > Settings > Environment
# Variables and redeploy. Leave unset to disable a network entirely;
# with none set, no marketing script is loaded at all.
# VITE_META_PIXEL_ID=
# VITE_PINTEREST_TAG_ID=
# VITE_TIKTOK_PIXEL_ID=

# Marketing scripts also require explicit visitor opt-in through Privacy choices.
# Consent is independent of the production-host/QA switch.

# TEMPORARY GA4 cross-domain test: set this only for the approved Vercel preview
# deployment, to its exact hostname (for example, branch-name.vercel.app).
# Vercel preview builds additionally require ?luxemia_preview_analytics=1.
# Do not use a wildcard or a production domain; remove this setting after testing.
# LUXEMIA_GA4_PREVIEW_HOST=
